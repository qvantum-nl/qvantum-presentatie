        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, onClose, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|thickness|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: tone, thickness."
      },
      {
